{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar y Ejecutar en CMD Externa",
            "type": "shell",
            "command": "start",
            "args": [
                "cmd.exe",
                "/k",
                "gcc",
                "${file}",
                "-o",
                "${fileBasenameNoExtension}.exe",
                "&&",
                "${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}